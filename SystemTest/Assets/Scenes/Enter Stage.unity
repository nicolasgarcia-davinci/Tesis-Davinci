    - target: {fileID: 8535600484126568061, guid: ee09b37f20ceb7f428d9b11155f06ef6, type: 3}
      propertyPath: m_text
      value: "Gary es un modelo anticuado, oxidado  y su \ncontinua funcionalidad
        es simplemente un \nmilagro.\n\nlos dias de gloria de gary han pasado\npero
        lo poco que le queda es util para \nentrenar a nuevos robots y a sus \nentrenadores
        en las bases del combate\nmoderno."
      objectReference: {fileID: 0}
