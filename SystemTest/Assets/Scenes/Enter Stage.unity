    - target: {fileID: 8535600484126568061, guid: ee09b37f20ceb7f428d9b11155f06ef6, type: 3}
      propertyPath: m_text
      value: "Dany es una figura con relativa fama dentro del gymnacio\nlocal, apesar
        de no ser particularmente  bueno como \npelador su entrenador esta convencido
        de que tiene \nlo nescesario para convertirse en campeon regional.\n\nsu
        entrenador esta siempre contento  con ofrecer a \ndany como oponente contrra
        el que uno puede \nentrenar a modo de entrada a las ligas menores."
      objectReference: {fileID: 0}
