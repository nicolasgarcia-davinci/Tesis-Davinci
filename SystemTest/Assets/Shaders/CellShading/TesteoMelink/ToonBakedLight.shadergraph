        },
        {
            "m_Id": "c92ee3d97b8f4d848e65fb4fa18e8a57"
        },
        {
            "m_Id": "bffd814708a845aeae23fb51fcd0602d"
        },
        {
            "m_Id": "91b3dc5ffc9d48bcb277453a9179713d"
        },
        {
            "m_Id": "b3400ed3594e402ea79ca1b38cd466c8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Get_Main_Light",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if SHADERGRAPH_PREVIEW\r\n    Direction = float3(0.5, 0.5, 0);\r\n    Color = float3(1, 1, 1);\r\n    DistanceAtten = 1;\r\n    ShadowAtten = 1;\r\n#else\r\n    float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\r\n    Light light = GetMainLight(shadowCoord);\r\n    Direction = light.direction;\r\n    Color = light.color;\r\n    DistanceAtten = light.distanceAttenuation;\r\n    ShadowAtten = light.shadowAttenuation;\r\n#endif"
}

